# The URL that the server will listen on
HOST=127.0.0.1

# The port that the server will listen on
PORT=3000

# The maximum number of todos the app will be able to store
MAX_TODOS=5

# Dev (SQLite, no setup needed)
DATABASE_URL=sqlite://todos.db?mode=rwc

# This example calls `.auto_migrate(true)` in main. When using `DatabaseConfig::from_env()` without that, set true for local dev or run `rapina migrate up` in production.
DATABASE_AUTO_MIGRATE=true

# Prod (Postgres via docker-compose)
# DATABASE_URL=postgres://todos:todos@localhost:5432/todos
