HOST=127.0.0.1
PORT=3000
CACHE_CAPACITY=10000
RATE_LIMIT_PER_MINUTE=60
DEFAULT_EXPIRY_DAYS=365

# Dev (SQLite, no setup needed)
DATABASE_URL=sqlite://urls.db?mode=rwc

# Apply migrations on startup when true. If unset, this example defaults to auto-migrate on for local dev; set false (or use `rapina migrate up`) for controlled deploys.
DATABASE_AUTO_MIGRATE=true

# Prod (Postgres via docker-compose)
# DATABASE_URL=postgres://shortener:shortener@localhost:5432/shortener
